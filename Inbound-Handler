// Function to determine if a call is outbound based on metadata
function isOutboundCall(metadata) {
    try {
        const parsedMetadata = typeof metadata === 'string' ? JSON.parse(metadata) : metadata;
        return parsedMetadata?.channel_type === 'outbound' || parsedMetadata?.is_outbound === true;
    } catch (error) {
        console.error('Error parsing metadata:', error);
        return false;
    }
}

// Modify the config query to handle both inbound and outbound
async function getCallConfig(conn, inboundNumber, metadata = null) {
    console.log('🔍 Getting call configuration:', { inboundNumber, metadata });
    
    try {
        const isOutbound = isOutboundCall(metadata);
        console.log(`Call type: ${isOutbound ? 'Outbound' : 'Inbound'}`);

        // Get the configuration from ai_agents and inbound_agent_config
        const configQuery = `
            SELECT 
                a.id,
                a.name,
                a.company,
                a.voice,
                a.base_prompt as agent_instructions,
                c.business_hours,
                c.inbound_number,
                c.description,
                CASE 
                    WHEN c.transfer_rules IS NOT NULL THEN
                        REPLACE(
                            REPLACE(
                                REPLACE(c.transfer_rules, '+1', ''
                            ), '"number": "1', '"number": "'
                        ), '+', ''
                    )
                    ELSE NULL
                END as transfer_rules
            FROM ai_agents a
            JOIN inbound_agent_config c ON a.id = c.agent_id
            WHERE c.inbound_number = ?`;
            
        const [config] = await conn.query(configQuery, [inboundNumber]);

        if (!config) {
            console.log('❌ No configuration found for number:', inboundNumber);
            return null;
        }

        // Parse transfer rules and validate against business hours
        let availableTransfers = [];
        if (config.transfer_rules) {
            console.log('🔄 Processing transfer rules:', config.transfer_rules);
            
            let rules = typeof config.transfer_rules === 'string' ? 
                JSON.parse(config.transfer_rules) : 
                config.transfer_rules;

            // Double check the numbers are clean
            rules = rules.map(rule => ({
                ...rule,
                number: rule.number.replace(/^\+?1?/, '').replace(/\D/g, '')
            }));
                
            console.log('📋 Parsed and cleaned rules:', rules);

            // Get current time in America/Chicago timezone
            const now = new Date();
            // Adjust for Central Time (UTC-5 or UTC-6)
            const centralTime = new Date(now.getTime() - (5 * 60 * 60 * 1000)); // Simplified to UTC-5 for now
            const currentDay = centralTime.getDay();
            const currentHour = centralTime.getHours();
            const currentMinute = centralTime.getMinutes();
            
            console.log('⏰ Current Central time:', {
                day: currentDay,
                hour: currentHour,
                minute: currentMinute,
                fullDate: centralTime.toISOString()
            });

            // Parse business hours
            const businessHours = config.business_hours ? 
                (typeof config.business_hours === 'string' ? 
                    JSON.parse(config.business_hours) : 
                    config.business_hours) : 
                null;
                
            console.log('⏰ Business hours:', businessHours);

            if (Array.isArray(rules)) {
                // Define days array for business hours lookup
                const days = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
                
                rules.forEach(rule => {
                    let isAvailable = true;
                    console.log('🔍 Processing rule:', rule);

                    // Don't allow transfer to the number we're calling from
                    if (rule.number === inboundNumber.replace(/^\+?1?/, '').replace(/\D/g, '')) {
                        console.log('❌ Skipping self-transfer number:', rule.number);
                        return;
                    }

                    // Check business hours condition if rule requires it
                    if (rule.condition === 'business_hours' && businessHours) {
                        const todayHours = businessHours[days[currentDay]];
                        console.log('⏰ Today\'s hours:', todayHours);
                        
                        if (todayHours) {
                            const [startHour, startMinute] = todayHours.start.split(':').map(Number);
                            const [endHour, endMinute] = todayHours.end.split(':').map(Number);
                            
                            const currentTime = currentHour * 60 + currentMinute;
                            const startTime = startHour * 60 + startMinute;
                            const endTime = endHour * 60 + endMinute;

                            isAvailable = currentTime >= startTime && currentTime <= endTime;
                            console.log('⏰ Time check:', {
                                currentTime,
                                startTime,
                                endTime,
                                isAvailable
                            });
                        } else {
                            isAvailable = false;
                            console.log('⏰ No hours defined for today');
                        }
                    }

                    if (isAvailable) {
                        availableTransfers.push({
                            number: rule.number,
                            name: rule.name || '',
                            trigger_phrases: rule.trigger_phrases || []
                        });
                        console.log('✅ Added transfer option:', {
                            number: rule.number,
                            name: rule.name || '',
                            trigger_phrases: rule.trigger_phrases || []
                        });
                    } else {
                        console.log('❌ Transfer not available:', {
                            number: rule.number,
                            name: rule.name || '',
                            reason: rule.condition === 'business_hours' ? 'Outside business hours' : 'Unknown'
                        });
                    }
                });
            }
        }

        // Get the transfer numbers from available transfers
        const transferNumbers = availableTransfers.map(t => t.number);
        console.log('📞 Available Transfer Numbers:', transferNumbers);

        console.log('📋 Retrieved configuration:', {
            name: config.name,
            company: config.company,
            voice: config.voice,
            isOutbound,
            hasAgentInstructions: !!config.agent_instructions,
            hasBusinessHours: !!config.business_hours,
            availableTransfers
        });

        // Create the system prompt
        const systemPrompt = isOutbound ? createOutboundPrompt(config) : createInboundPrompt(config, availableTransfers);

        return {
            config,
            availableTransfers
        };

    } catch (error) {
        console.error('Error getting call configuration:', error);
        throw error;
    }
}

