// Define the incoming call handler
async function handleIncomingCall(request, reply) {
    console.log('📞 Raw Twilio Request Body:', request.body);
    
    const callId = request.body.CallSid || 
                  request.body.callSid || 
                  request.body.call_sid ||
                  request.query.CallSid;
                  
    if (!callId) {
        console.error('❌ No CallSid found in request');
        throw new Error('No CallSid provided in request');
    }

    // Check if we can accept the call
    if (!callTracker.canAcceptInbound()) {
        console.log('⚠️ Cannot accept inbound call - system at capacity');
        const twiml = new twilio.twiml.VoiceResponse();
        twiml.say('We are currently experiencing high call volume. Please try your call again later.');
        twiml.hangup();
        reply.header('Content-Type', 'text/xml');
        return twiml.toString();
    }

    let conn;
    try {
        const inboundNumber = request.body.To.replace(/[^+\d]/g, '');
        console.log('🔍 Normalized inbound number:', inboundNumber);
        
        // Track the inbound call
        callTracker.addInbound(callId);
        
        conn = await getConnection();
        
        // Get call configuration
        const { config, availableTransfers } = await getCallConfig(conn, inboundNumber, {
            channel_type: 'inbound',
            is_outbound: false
        });

        if (!config) {
            console.log('❌ No training data found for number:', inboundNumber);
            const twiml = new twilio.twiml.VoiceResponse();
            twiml.say('We are currently experiencing technical difficulties. Please try your call again later.');
            twiml.hangup();
            reply.header('Content-Type', 'text/xml');
            return twiml.toString();
        }

        // Create conversation record
        const conversationId = uuidv4();
        await conn.query(
            `INSERT INTO conversations 
             (id, agent_id, user_number, contact_info, channel_type, status, start_time, metadata) 
             VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
            [
                conversationId,
                config.id,
                request.body.From,
                request.body.From,
                'inbound',
                'initiated',
                new Date(),
                JSON.stringify({
                    ultravox_id: null, // Will be updated after Ultravox call
                    twilio_sid: callId,
                    recording_enabled: true,
                    summary: true,
                    short_summary: true,
                    end_reason: null,
                    error_count: 0
                })
            ]
        );

        // Debug log the transfer rules
        console.log('🔄 Transfer Rules Debug:', {
            raw: config.transfer_rules,
            parsed: typeof config.transfer_rules === 'string' ? 
                JSON.parse(config.transfer_rules) : 
                config.transfer_rules
        });

        // Get the transfer numbers from available transfers
        const transferNumbers = availableTransfers.map(t => t.number);
        console.log('📞 Available Transfer Numbers:', transferNumbers);

        // Get tools for this agent
        const agentTools = await getAgentTools(conn, config.id);
        
        // Format tools for Ultravox
        const formattedTools = formatToolsForUltravox(agentTools, callId, inboundNumber);

        const selectedTools = [
            { "toolName": "hangUp" },
            // Include the transfer tool if transfer_rules exist
            ...(config.transfer_rules ? [{
                "temporaryTool": {
                    "modelToolName": "transfer",
                    "description": "Transfer the call to another person",
                    "dynamicParameters": [
                        {
                            "name": "callSid",
                            "location": "PARAMETER_LOCATION_BODY",
                            "schema": {
                                "type": "string",
                                "description": "The current call SID",
                                "enum": [callId]
                            },
                            "required": true
                        },
                        {
                            "name": "transferNumber",
                            "location": "PARAMETER_LOCATION_BODY",
                            "schema": {
                                "type": "string",
                                "description": "The phone number to transfer to",
                                "enum": availableTransfers.map(t => t.number)
                            },
                            "required": true
                        },
                        {
                            "name": "fromNumber",
                            "location": "PARAMETER_LOCATION_BODY",
                            "schema": {
                                "type": "string",
                                "description": "The number to transfer from",
                                "enum": [inboundNumber.replace(/^\+?1?/, '').replace(/\D/g, '')]
                            },
                            "required": true
                        }
                    ],
                    "http": {
                        "baseUrlPattern": `${process.env.BASE_URL}/transfer-handler/transfer`,
                        "httpMethod": "POST"
                    }
                }
            }] : []),
            ...formattedTools
        ];
        
        // Initialize call in Ultravox
        const response = await fetch('https://api.ultravox.ai/api/calls', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-API-Key': process.env.ULTRAVOX_API_KEY
            },
            body: JSON.stringify({
                systemPrompt: createInboundPrompt(config, availableTransfers),
                model: 'fixie-ai/ultravox',
                voice: config.voice || 'echo',
                temperature: 0.3,
                medium: { "twilio": {} },
                recordingEnabled: true,
                selectedTools: selectedTools
            })
        });

        if (!response.ok) {
            throw new Error(`Failed to create Ultravox call: ${await response.text()}`);
        }

        const ultravoxResponse = await response.json();

        // Update conversation with Ultravox ID
        await conn.query(
            `UPDATE conversations 
             SET metadata = JSON_SET(metadata, '$.ultravox_id', ?) 
             WHERE id = ?`,
            [ultravoxResponse.callId, conversationId]
        );

        // Generate TwiML
        const twiml = new twilio.twiml.VoiceResponse();
        const connect = twiml.connect();
        const stream = connect.stream({
            url: ultravoxResponse.joinUrl,
            name: 'ultravox'
        });

        stream.parameter('CallSid', callId);
        stream.parameter('call_sid', callId);
        stream.parameter('from', request.body.From);
        stream.parameter('to', request.body.To);

        // Start monitoring
        monitorUltravoxCall(ultravoxResponse.callId);

        reply.header('Content-Type', 'text/xml');
        return twiml.toString();

    } catch (error) {
        console.error('❌ Error handling call:', error);
        // Remove call from tracker in case of error
        callTracker.removeCall(callId, false);
        const twiml = new twilio.twiml.VoiceResponse();
        twiml.say('Sorry, we are unable to connect your call at this time. Please try again later.');
        twiml.hangup();
        reply.header('Content-Type', 'text/xml');
        return twiml.toString();
    } finally {
        if (conn) await conn.release();
    }
}

