// After the activeCalls declaration
const activeCallMonitors = new Map();

// Add these constants near the top
const MAX_POLL_ATTEMPTS = 10;
const POLL_INTERVAL = 2000; // 2 seconds
const FINAL_WAIT_TIME = 5000; // 5 seconds after call ends

// Add after the activeCalls declaration
const MAX_CONCURRENT_CALLS = 20; // Maximum total concurrent calls (inbound + outbound)
const MAX_CONCURRENT_OUTBOUND = 10; // Maximum concurrent outbound calls
const MAX_CONCURRENT_INBOUND = 10; // Maximum concurrent inbound calls
const RATE_LIMIT_WINDOW = 60000; // 1 minute window
const MAX_CALLS_PER_WINDOW = 30; // Maximum calls per minute

// Add call tracking
const callTracker = {
    inboundCount: 0,
    outboundCount: 0,
    recentCalls: [], // Track calls for rate limiting
    
    canAcceptInbound() {
        this.cleanupRecentCalls();
        return this.inboundCount < MAX_CONCURRENT_INBOUND && 
               (this.inboundCount + this.outboundCount) < MAX_CONCURRENT_CALLS &&
               this.recentCalls.length < MAX_CALLS_PER_WINDOW;
    },
    
    canAcceptOutbound() {
        this.cleanupRecentCalls();
        return this.outboundCount < MAX_CONCURRENT_OUTBOUND && 
               (this.inboundCount + this.outboundCount) < MAX_CONCURRENT_CALLS &&
               this.recentCalls.length < MAX_CALLS_PER_WINDOW;
    },
    
    addInbound(callId) {
        this.inboundCount++;
        this.recentCalls.push({ timestamp: Date.now(), callId });
        console.log('📈 Call Stats - Added Inbound:', {
            inbound: this.inboundCount,
            outbound: this.outboundCount,
            total: this.inboundCount + this.outboundCount,
            recentCalls: this.recentCalls.length
        });
    },
    
    addOutbound(callId) {
        this.outboundCount++;
        this.recentCalls.push({ timestamp: Date.now(), callId });
        console.log('📈 Call Stats - Added Outbound:', {
            inbound: this.inboundCount,
            outbound: this.outboundCount,
            total: this.inboundCount + this.outboundCount,
            recentCalls: this.recentCalls.length
        });
    },
    
    removeCall(callId, isOutbound) {
        if (isOutbound) {
            this.outboundCount = Math.max(0, this.outboundCount - 1);
        } else {
            this.inboundCount = Math.max(0, this.inboundCount - 1);
        }
        this.recentCalls = this.recentCalls.filter(call => call.callId !== callId);
        console.log('📉 Call Stats - Removed Call:', {
            inbound: this.inboundCount,
            outbound: this.outboundCount,
            total: this.inboundCount + this.outboundCount,
            recentCalls: this.recentCalls.length
        });
    },
    
    cleanupRecentCalls() {
        const cutoff = Date.now() - RATE_LIMIT_WINDOW;
        this.recentCalls = this.recentCalls.filter(call => call.timestamp > cutoff);
    }
};

// Add cleanup on process exit
