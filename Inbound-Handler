// Add this function to handle call completion
async function handleCallCompletion(callId, ultravoxId) {
    try {
        console.log('🔄 Starting call completion handling:', { callId, ultravoxId });
        
        // Wait a few seconds to ensure Ultravox has processed everything
        await setTimeout(FINAL_WAIT_TIME);
        
        // Poll for call data
        let attempts = 0;
        let callData = null;
        
        while (attempts < MAX_POLL_ATTEMPTS) {
            try {
                const response = await fetch(`https://api.ultravox.ai/api/calls/${ultravoxId}`, {
                    headers: {
                        'X-API-Key': process.env.ULTRAVOX_API_KEY
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`API returned ${response.status}`);
                }
                
                callData = await response.json();
                console.log('🎯 Call data received:', {
                    callId,
                    ultravoxId,
                    hasTranscript: !!callData.transcript,
                    hasSummary: !!callData.summary,
                    hasShortSummary: !!callData.shortSummary,
                    ended: !!callData.ended
                });
                
                // Check if we have all the data we need and the call has ended
                if (callData.ended && callData.transcript) {
                    break;
                }
                
                console.log(`📝 Waiting for complete data (attempt ${attempts + 1}/${MAX_POLL_ATTEMPTS})`);
                await setTimeout(POLL_INTERVAL);
                attempts++;
                
            } catch (error) {
                console.error('❌ Error polling call data:', error);
                await setTimeout(POLL_INTERVAL);
                attempts++;
            }
        }
        
        if (!callData) {
            throw new Error(`Failed to retrieve call data after ${MAX_POLL_ATTEMPTS} attempts`);
        }
        
        // Update database with call data
        const conn = await getConnection();
        try {
            // Get recording if available
            let recordingUrl = null;
            if (callData.recordingEnabled) {
                console.log(`[${ultravoxId}] Fetching recording...`);
                const recordingResponse = await fetch(`https://api.ultravox.ai/api/calls/${ultravoxId}/recording`, {
                    headers: { 'X-API-Key': process.env.ULTRAVOX_API_KEY }
                });
                
                if (recordingResponse.ok) {
                    const recordingsDir = '/var/www/vhosts/example.com/httpdocs/recordings';
                    if (!fs.existsSync(recordingsDir)) {
                        fs.mkdirSync(recordingsDir, { recursive: true });
                    }

                    const [conversation] = await conn.query(
                        `SELECT id FROM conversations WHERE metadata LIKE ?`,
                        [`%${callId}%`]
                    );

                    if (conversation) {
                        const fileName = `${conversation.id}.wav`;
                        const filePath = `${recordingsDir}/${fileName}`;
                        const arrayBuffer = await recordingResponse.arrayBuffer();
                        fs.writeFileSync(filePath, Buffer.from(arrayBuffer));
                        recordingUrl = `${process.env.BASE_URL}/recordings/${fileName}`;
                        console.log(`[${ultravoxId}] Saved recording to ${recordingUrl}`);
                    }
                }
            }

            // Update conversation record
            console.log(`[${callId}] Updating conversation record...`);
            const updateResult = await conn.query(
                `UPDATE conversations 
                 SET status = ?,
                     end_time = ?,
                     recording_url = ?,
                     transcript = ?,
                     metadata = JSON_SET(
                        COALESCE(metadata, '{}'),
                        '$.summary', ?,
                        '$.short_summary', ?,
                        '$.end_reason', ?,
                        '$.error_count', ?
                     )
                 WHERE metadata LIKE ?`,
                [
                    'completed',
                    new Date(callData.ended),
                    recordingUrl,
                    JSON.stringify(callData.transcript),
                    callData.summary,
                    callData.shortSummary,
                    callData.endReason,
                    callData.errorCount || 0,
                    `%${callId}%`
                ]
            );
            console.log(`[${callId}] Update result:`, updateResult);

            isActive = false;
            activeCallMonitors.delete(callId);
            console.log(`[${callId}] Call processing completed`);
            return;
        } finally {
            if (conn) {
                await conn.end();
                conn = null;
            }
        }
    } catch (error) {
        console.error('❌ Error handling call completion:', error);
        throw error;
    }
}
