// Create a connection pool
const pool = mariadb.createPool(dbConfig);

// Track pool usage
let activeConnections = 0;
let totalConnections = 0;

// Wrap getConnection to track usage
const getConnection = async () => {
    try {
        const conn = await pool.getConnection();
        activeConnections++;
        totalConnections = Math.max(totalConnections, activeConnections);
        
        // Wrap the release method to track connection release
        const originalRelease = conn.release;
        conn.release = () => {
            activeConnections--;
            return originalRelease.call(conn);
        };
        
        return conn;
    } catch (error) {
        console.error('Failed to get connection:', error);
        throw error;
    }
};

