});

// Add the monitor function
async function monitorUltravoxCall(callId) {
    console.log(`[${callId}] Starting call monitor`);
    
    let isActive = true;
    let startTime = Date.now();
    let endedTime = null;

    const monitor = async () => {
        if (!isActive) {
            console.log(`[${callId}] Monitor stopped`);
            return;
        }

        let conn;
        try {
            console.log(`[${callId}] Checking call status...`);
            const response = await fetch(`https://api.ultravox.ai/api/calls/${callId}`, {
                headers: {
                    'X-API-Key': process.env.ULTRAVOX_API_KEY
                }
            });

            if (!response.ok) {
                throw new Error(`Failed to get call data: ${response.statusText}`);
            }

            const callData = await response.json();
            
            if (callData.ended) {
                if (!endedTime) {
                    endedTime = Date.now();
                }
                
                try {
                    console.log(`[${callId}] Processing ended call...`);
                    conn = await getConnection();
                    
                    // Get recording if available
                    let recordingUrl = null;
                    if (callData.recordingEnabled) {
                        console.log(`[${callId}] Fetching recording...`);
                        const recordingResponse = await fetch(`https://api.ultravox.ai/api/calls/${callId}/recording`, {
                            headers: { 'X-API-Key': process.env.ULTRAVOX_API_KEY }
                        });
                        
                        console.log(`[${callId}] Recording API response:`, recordingResponse.status);
                        
                        if (recordingResponse.ok) {
                            const recordingsDir = '/var/www/vhosts/example.com/httpdocs/recordings';
                            if (!fs.existsSync(recordingsDir)) {
                                fs.mkdirSync(recordingsDir, { recursive: true });
                            }

                            const [conversation] = await conn.query(
                                `SELECT id FROM conversations WHERE metadata LIKE ?`,
                                [`%${callId}%`]
                            );

                            if (conversation) {
                                const fileName = `${conversation.id}.wav`;
                                const filePath = `${recordingsDir}/${fileName}`;
                                const arrayBuffer = await recordingResponse.arrayBuffer();
                                fs.writeFileSync(filePath, Buffer.from(arrayBuffer));
                                recordingUrl = `${BASE_URL}/recordings/${fileName}`;
                                console.log(`[${callId}] Saved recording to ${recordingUrl}`);
                            }
                        }
                    }

                    // Update conversation record
                    console.log(`[${callId}] Updating conversation record...`);
                    const updateResult = await conn.query(
                        `UPDATE conversations 
                         SET status = ?,
                             end_time = ?,
                             recording_url = ?,
                             transcript = ?,
                             metadata = JSON_SET(
                                COALESCE(metadata, '{}'),
                                '$.summary', ?,
                                '$.short_summary', ?,
                                '$.end_reason', ?,
                                '$.error_count', ?
                             )
                         WHERE metadata LIKE ?`,
                        [
                            'completed',
                            new Date(callData.ended),
                            recordingUrl,
                            callData.summary || null,
                            callData.summary,
                            callData.shortSummary,
                            callData.endReason,
                            callData.errorCount || 0,
                            `%${callId}%`
                        ]
                    );
                    console.log(`[${callId}] Update result:`, updateResult);

                    isActive = false;
                    activeCallMonitors.delete(callId);
                    console.log(`[${callId}] Call processing completed`);
                    return;
                } finally {
                    if (conn) {
                        await conn.end();
                        conn = null;
                    }
                }
            }

            // Fix: Use proper setTimeout for promises
            if (isActive) {
                await setTimeout(5000);  // Just pass the number of milliseconds
                monitor();  // Call monitor after the delay
            }

        } catch (error) {
            console.error(`[${callId}] Error monitoring call:`, error);
            if (isActive) {
                await setTimeout(5000);  // Fix here too
                monitor();
            }
        } finally {
            if (conn) {
                await conn.end();
                conn = null;
            }
        }
    };

    // Start the monitor
    monitor();
    
    // Store the monitor reference
    activeCallMonitors.set(callId, { 
        stop: () => { 
            isActive = false;
            console.log(`[${callId}] Monitor stop requested`);
        } 
    });
}

