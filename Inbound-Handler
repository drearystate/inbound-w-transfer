// Add a function to format tools for Ultravox
function formatToolsForUltravox(tools, callId, inboundNumber) {
    return tools.map(tool => {
        try {
            // Skip weather tool
            if (tool.tool_id === 'weather') {
                console.log('⚠️ Skipping weather tool for compatibility');
                return null;
            }

            // Handle tool definition parsing
            let toolDef = tool.definition;
            if (typeof toolDef === 'string') {
                toolDef = JSON.parse(toolDef);
            } else if (typeof toolDef === 'object') {
                toolDef = toolDef;
            } else {
                console.error('Invalid tool definition format:', toolDef);
                return null;
            }

            // Handle configuration parsing
            let config = {};
            if (tool.configuration) {
                try {
                    config = typeof tool.configuration === 'string' ? 
                        JSON.parse(tool.configuration) : 
                        tool.configuration;
                } catch (e) {
                    console.error('Error parsing tool configuration:', e);
                }
            }

            // If it's a standard tool (like hangUp), return it directly
            if (toolDef.type === 'standard') {
                return { "toolName": tool.tool_id };
            }

            // For custom tools, create a temporaryTool object
            const tempTool = {
                "modelToolName": tool.tool_id,
                "dynamicParameters": []
            };

            // Add parameters from the tool definition
            if (toolDef.parameters) {
                tempTool.dynamicParameters = toolDef.parameters.map(param => ({
                    name: param.name,
                    location: param.location || "PARAMETER_LOCATION_BODY",
                    schema: {
                        type: param.schema.type,
                        description: param.schema.description,
                        enum: param.schema.enum
                    },
                    required: param.required || false
                }));

                // Replace special variables in enum values
                tempTool.dynamicParameters.forEach(param => {
                    if (param.schema && param.schema.enum) {
                        if (param.name === 'callSid') {
                            param.schema.enum = [callId];
                        } else if (param.name === 'fromNumber') {
                            param.schema.enum = [inboundNumber];
                        }
                    }
                });
            }

            // Add HTTP configuration
            if (toolDef.http) {
                tempTool.http = {
                    "baseUrlPattern": `${process.env.BASE_URL}/transfer-handler/transfer`,
                    "httpMethod": toolDef.http.httpMethod
                };
            }

            return { "temporaryTool": tempTool };
        } catch (error) {
            console.error('Error formatting tool:', tool.tool_id, error);
            return null;
        }
    }).filter(Boolean); // Remove any null entries from failed parsing
}

